# Overrides the canonical origin. Only needed for a staging deployment —
# production already defaults to https://dukatdesk.com (see lib/site.ts).
NEXT_PUBLIC_SITE_URL=

# Where the written quote form posts. Leave empty to use the bundled
# /api/quote route handler (see lib/quote.ts).
NEXT_PUBLIC_QUOTE_ENDPOINT=

# Telegram bot that delivers written quote requests to the desk.
# Server-side only — never prefix these with NEXT_PUBLIC, that would ship the
# token to the browser. Setup steps are in the README.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Analytics and advertising. Both are public identifiers, not secrets — they
# appear in the page source of every site that uses them.
# The Meta Pixel id is already set in lib/consent.ts; this only overrides it.
# Leave NEXT_PUBLIC_GA_ID empty and Google Analytics is never loaded at all.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API. This one IS a secret — no NEXT_PUBLIC prefix, or the
# token ships to every browser. Events Manager -> Settings -> Conversions API
# -> Generate access token. Unset means server-side events are simply not sent.
META_CAPI_TOKEN=

# Graph API version used for the Conversions API. Override only if Meta
# retires the default in lib/meta.ts.
META_GRAPH_VERSION=
