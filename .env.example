# Public base URL used for canonical tags, hreflang alternates, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://dukat.example

# Endpoint that receives private quote requests (see lib/quote.ts).
# Leave empty in development: the form then runs in demonstration mode and
# does not transmit anything.
NEXT_PUBLIC_QUOTE_ENDPOINT=

# Endpoint that serves indicative rates (see lib/rates.ts).
# Leave empty to use the static fallback table shipped with the frontend.
NEXT_PUBLIC_RATES_ENDPOINT=
